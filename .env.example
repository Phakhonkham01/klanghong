# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server only, for `pnpm db:migrate`. Connect button → Session pooler URI (port 5432).
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# SMS OTP via WENOVA Link (server only). Dashboard → Key.
WENOVA_API_TOKEN=
# Optional: sender header and whether to deduct from your SMS package.
WENOVA_SMS_HEADER=WNV-OTP
WENOVA_USE_PACKAGE=false
# Optional: separate secret for hashing OTP codes (defaults to the service role key).
OTP_SECRET=
# Optional: max OTP SMS per 24h for the whole app (abuse guard).
OTP_GLOBAL_DAILY_LIMIT=100
# Development only: log OTP codes to the server console instead of sending SMS.
OTP_DEV_LOG=0

# First committee account (pnpm seed:admin)
ADMIN_CODE=admin001
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=ຄະນະກຳມະການ

APP_TIMEZONE=Asia/Vientiane
